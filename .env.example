# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# --- Supabase / Postgres ---------------------------------------------------
# Direct connection string from Supabase (Project Settings -> Database).
# Percent-encode any special characters in the password.
# Supabase connection pooler string (Port 6543 / 5432)
DATABASE_URL=postgresql://postgres.wedxmgtnmtfgdkolacjl:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# If Postgres instead runs as a Railway service in the SAME Railway project as
# this server (the Hub), use Railway's private-network connection string here
# (internal host like postgres.railway.internal, from the DB service's
# "Connect" tab) — private-network traffic isn't metered, unlike the public
# one. Only the Hub deployment needs this; a local fetcher using HUB_URL below
# doesn't need DATABASE_URL at all.

# Optional overrides:
# DATABASE_SSL=false          # disable TLS (local Postgres only)
# DATABASE_POOL_MAX=5         # max pooled connections

# --- Hub API (remote write-through) ----------------------------------------
# Set on the HUB deployment (this server running on Railway, in the same
# project as Postgres) to protect /api/hub/* endpoints. Generate a long
# random value; keep it secret. Unset = /api/hub/* endpoints stay locked.
# HUB_API_KEY=

# Set on a LOCAL fetcher (this machine, off Railway) to write through the
# Hub's HTTP API instead of connecting to Postgres directly — Postgres reads
# and writes then happen entirely inside Railway's free private network, and
# only small JSON payloads (not raw Postgres wire traffic) cross the public
# internet, avoiding Railway's public-Postgres egress charge. When HUB_URL is
# set, this machine needs no DATABASE_URL at all.
# HUB_URL=https://<your-railway-app>.up.railway.app
# HUB_API_KEY=

# --- Crawl limits ----------------------------------------------------------
# Upper bound on how many articles a single `since` backfill will extract.
# Big enough for real multi-day pulls, bounded so a backfill never runs forever.
# BACKFILL_MAX=300

# --- Enrichment provider (editorial pipeline) ------------------------------
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=sonnet-5

# --- AGY (Antigravity CLI) profile pool -------------------------------------
# AGY has no API key: a session is a Google sign-in held in the OS keychain.
# Install the CLI with:
#   curl -fsSL https://antigravity.google/cli/install.sh | bash
# Then build the account pool (one sign-in per profile):
#   node src/agy/agy-cli.js add work-1
#   node src/agy/agy-cli.js list
#
# Profile isolation works by redirecting HOME so agy reads that profile's
# keychain. Verified on macOS. NOT possible on Windows, where Credential
# Manager is per-OS-user — that host needs AGY_ROTATION_RUNNER below.
#
# AGY_BIN=                    # override CLI path (default: ~/.local/bin/agy)
# AGY_DATA_ROOT=              # profile store root (default: ~/.news-fetcher/agy)
# AGY_MODEL=gemini-3.6-flash-high   # id from `agy models`, NOT a display name
# AGY_MAX_CONCURRENCY=3       # concurrent agy calls
# AGY_MIN_INTERVAL_MS=4000    # minimum gap between call starts
# AGY_REFINE=0                # single generate pass instead of generate+perfect
#
# Quota/auth detection patterns are broad by default; add host-specific ones
# here if a rejection is being misread (an unmatched error never cools a profile).
# AGY_QUOTA_PATTERN=
# AGY_AUTH_PATTERN=
#
# Set only to keep using low-legion's external runner instead of the in-repo
# pool (e.g. on the Windows box where Legion owns the accounts).
# AGY_ROTATION_RUNNER=C:/Users/Eternalgy/projects/low-legion/run-agy-agent.mjs
